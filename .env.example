# Spotify "now playing" on the Personal tab (see README, "Spotify now playing").
# Copy to .env.local for local use; on Vercel, set them under Settings >
# Environment Variables (Production and Preview). Without them the card shows
# a link to the Spotify profile and /api/now-playing answers "unconfigured".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam on the Personal tab, optional (see README, "Games"). With a Web API
# key from https://steamcommunity.com/dev/apikey the card shows the game being
# played and the last two weeks; without it, a link to the Steam profile and
# /api/steam answers "unconfigured". The profile and its game details must be
# public. STEAM_ID (17-digit SteamID64) is optional: without it the vanity name
# in src/content/personal.ts is resolved once.
STEAM_API_KEY=
STEAM_ID=

# Valorant rank and stats on the Personal tab, optional (see README, "Games").
# A key from the HenrikDev dashboard (https://api.henrikdev.xyz/dashboard/,
# "API Keys" > "Generate New Key"). Without it the Valorant row links to
# Tracker.gg and /api/trackers answers "unconfigured" for it.
HENRIK_API_KEY=

# Rainbow Six Siege rank and stats, optional (see README, "Games"). A key from
# R6Data by Arenyze (https://r6.arenyze.com/dashboard). Without it the Siege
# row links to Tracker.gg.
R6DATA_API_KEY=

# Search Console and Bing Webmaster Tools, optional (see docs/seo-aeo.md,
# "Measure"). The content of the verification meta tag each one gives you
# ("HTML tag" method). Not needed when the domain is verified through DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
