# Spotify "now playing" on the Personal tab (see README, "Spotify now playing").
# Copy to .env.local for local use; on Vercel, set them under Settings >
# Environment Variables (Production and Preview). Without them the card shows
# a link to the Spotify profile and /api/now-playing answers "unconfigured".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam on the Personal tab, optional (see README, "Games"). With a Web API
# key from https://steamcommunity.com/dev/apikey the card shows the game being
# played and the last two weeks; without it, a link to the Steam profile and
# /api/steam answers "unconfigured". The profile and its game details must be
# public. STEAM_ID (17-digit SteamID64) is optional: without it the vanity name
# in src/content/personal.ts is resolved once.
STEAM_API_KEY=
STEAM_ID=
