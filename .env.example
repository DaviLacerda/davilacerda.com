# Spotify "now playing" on the Personal tab (see README, "Spotify now playing").
# Copy to .env.local for local use; on Vercel, set them under Settings >
# Environment Variables (Production and Preview). Without them the card shows
# a link to the Spotify profile and /api/now-playing answers "unconfigured".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
